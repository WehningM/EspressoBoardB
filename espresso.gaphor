</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>never apply full-wave mains to the pump under any single failure</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="754de42d-8e8e-11f1-8afb-01c58a30f183">
