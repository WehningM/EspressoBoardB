<reflist>
<ref refid="770e7817-8e8e-11f1-8897-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>not persist faults across a power cycle, heater continuity being re-checked at self-test instead</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73d02805-8e8e-11f1-a27d-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="7413ac18-8e8e-11f1-926d-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
