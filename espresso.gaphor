<reflist>
<ref refid="770feb07-8e8e-11f1-83e0-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>expire a queued shot after OB-8 and inform the operator</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="769e31ab-8e8e-11f1-ac0d-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="76c4c3f5-8e8e-11f1-ab5c-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-MOD-008</val>
</externalId>
<name>
<val>REQ-SUB-MOD-008</val>
</name>
<owningPackage>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="76aaa1b4-8e8e-11f1-b1db-01c58a30f183"/>
</reflist>
