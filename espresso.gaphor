<UML:Property id="c1f7294b-c64c-11f1-b9ca-a029427ff6d8">
<name>
<val>finished weighing unit, M5Stack SKU U177</val>
</name>
<structuredClassifier>
<ref refid="c1f71e68-c64c-11f1-ba40-a029427ff6d8"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f73e4d-c64c-11f1-a7b5-a029427ff6d8">
<name>
<val>5 kg load cell, HX711 converter and STM32F030 controller integrated</val>
</name>
<structuredClassifier>
<ref refid="c1f71e68-c64c-11f1-ba40-a029427ff6d8"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f74b00-c64c-11f1-9e91-a029427ff6d8">
<name>
<val>interface = I2C, address 0x26</val>
</name>
<structuredClassifier>
<ref refid="c1f71e68-c64c-11f1-ba40-a029427ff6d8"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f7563c-c64c-11f1-84f5-a029427ff6d8">
<name>
<val>HY2.0-4P connector: GND, 5 V, SDA, SCL</val>
</name>
<structuredClassifier>
<ref refid="c1f71e68-c64c-11f1-ba40-a029427ff6d8"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f760b9-c64c-11f1-a8a9-a029427ff6d8">
<name>
<val>conversion, filtering and tare handled inside the unit</val>
</name>
<structuredClassifier>
<ref refid="c1f71e68-c64c-11f1-ba40-a029427ff6d8"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f76b0c-c64c-11f1-9898-a029427ff6d8">
<name>
<val>needs only the I2C bus and its supply, no further electronics</val>
</name>
<structuredClassifier>
<ref refid="c1f71e68-c64c-11f1-ba40-a029427ff6d8"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f7d944-c64c-11f1-a157-a029427ff6d8">
<name>
<val>cup grate on a lever bonded to the load cell</val>
</name>
<structuredClassifier>
<ref refid="71160859-8e8e-11f1-a2fd-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f7e43d-c64c-11f1-b2a5-a029427ff6d8">
<name>
<val>load cell outside the drip area</val>
</name>
<structuredClassifier>
<ref refid="71160859-8e8e-11f1-a2fd-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f7eeb7-c64c-11f1-a0c5-a029427ff6d8">
<name>
<val>M5Stack Unit Mini Scales (CON-7): cell, HX711 and controller in one unit</val>
</name>
<structuredClassifier>
<ref refid="71160859-8e8e-11f1-a2fd-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f7f914-c64c-11f1-9f66-a029427ff6d8">
<name>
<val>I2C to HN-1 on the shared sensor bus, address 0x26</val>
</name>
<structuredClassifier>
<ref refid="71160859-8e8e-11f1-a2fd-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f8041f-c64c-11f1-b19f-a029427ff6d8">
<name>
<val>no scale electronics on Board A beyond the connector</val>
</name>
<structuredClassifier>
<ref refid="71160859-8e8e-11f1-a2fd-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f80e6b-c64c-11f1-8dc6-a029427ff6d8">
<name>
<val>grate must not touch the tray: no force path bypassing the cell</val>
</name>
<structuredClassifier>
<ref refid="71160859-8e8e-11f1-a2fd-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f8187c-c64c-11f1-bfa1-a029427ff6d8">
<name>
<val>pump vibration at 50 Hz couples into the cell</val>
</name>
<structuredClassifier>
<ref refid="71160859-8e8e-11f1-a2fd-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f8606f-c64c-11f1-b755-a029427ff6d8">
<name>
<val>5 kg rated, integrated in the Mini Scales unit (CON-7)</val>
</name>
<structuredClassifier>
<ref refid="748c916b-8e8e-11f1-81b5-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f86b47-c64c-11f1-94fd-a029427ff6d8">
<name>
<val>lever ratio free, capacity not limiting (OI-12 closed)</val>
</name>
<structuredClassifier>
<ref refid="748c916b-8e8e-11f1-81b5-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f875ca-c64c-11f1-8aa6-a029427ff6d8">
<name>
<val>outside the wetted area</val>
</name>
<structuredClassifier>
<ref refid="748c916b-8e8e-11f1-81b5-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f8bc2d-c64c-11f1-8109-a029427ff6d8">
<name>
<val>M5Stack Unit Mini Scales, finished module (CON-7)</val>
</name>
<structuredClassifier>
<ref refid="748cba3b-8e8e-11f1-9953-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c1f8c6b8-c64c-11f1-a61a-a029427ff6d8">
<name>
<val>HX711 conversion and filtering inside the unit</val>
</name>
