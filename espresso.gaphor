<ref refid="770dcfc6-8e8e-11f1-93e7-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>reject unknown commands, out-of-range parameters, any command setting both A and B, and any use of the withdrawn C parameter</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="72a6413d-8e8e-11f1-9a31-01c58a30f183">
<clientDependency>
<reflist>
