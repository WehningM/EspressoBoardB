</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>switch the three-way valve so that the unpowered position is the tray path</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="754de17d-8e8e-11f1-9fb5-01c58a30f183">
<clientDependency>
