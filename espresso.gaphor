<val>read the weight from the scale unit at 10 readings per second or faster</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="7449ff40-8e8e-11f1-b717-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="74606646-8e8e-11f1-bc12-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
