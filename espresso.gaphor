<reflist>
<ref refid="770f0137-8e8e-11f1-94a4-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>close the loop on flow derived from tick intervals rather than tick counts per window</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="7539da13-8e8e-11f1-9b02-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="75483cb8-8e8e-11f1-8e9b-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-FLW-002</val>
</externalId>
