</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>count flow ticks in an interrupt, so no tick is lost to task scheduling</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="75989efc-8e8e-11f1-8d26-01c58a30f183">
