<ref refid="770e7b8e-8e8e-11f1-8932-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>not lock the operator out after repeated faults, retry remaining available</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73d02a19-8e8e-11f1-bc4a-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="7415d4a4-8e8e-11f1-af76-01c58a30f183"/>
