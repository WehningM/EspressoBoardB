<reflist>
<ref refid="770e304c-8e8e-11f1-86a8-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>cap commanded power at measured flow times specific heat times the rise from tank temperature to 97 C, so the outlet cannot be driven past CON-12 and power falls to zero as flow falls to zero</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73686c0f-8e8e-11f1-8e71-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="738c8a78-8e8e-11f1-b504-01c58a30f183"/>
</reflist>
