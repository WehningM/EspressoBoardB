<ref refid="770ecf6a-8e8e-11f1-9b71-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>reject a profile that commands temperature above the FTH outlet ceiling</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="74d7131f-8e8e-11f1-aa0d-01c58a30f183">
<clientDependency>
<reflist>
