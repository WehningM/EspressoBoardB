</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>run backflush and descaling as fixed internal sequences, not as E-Code</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="765318e7-8e8e-11f1-9e53-01c58a30f183">
