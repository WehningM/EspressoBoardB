<SysML:Requirement id="73d00a03-8e8e-11f1-9fd3-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="73fbd24b-8e8e-11f1-bf75-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-SUP-001</val>
</externalId>
<name>
<val>REQ-SUB-SUP-001</val>
</name>
<owningPackage>
<ref refid="73d002fa-8e8e-11f1-96db-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="73d002fa-8e8e-11f1-96db-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="73d034a7-8e8e-11f1-878d-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770e4ecb-8e8e-11f1-96f5-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770e4ecb-8e8e-11f1-96f5-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>kick the watchdog only when its own checks pass and sensor data is fresh, so a crashed supervisor stops holding the contactor closed</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73d00e2a-8e8e-11f1-aba8-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="73ff9b95-8e8e-11f1-a32c-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-SUP-002</val>
</externalId>
<name>
<val>REQ-SUB-SUP-002</val>
</name>
<owningPackage>
<ref refid="73d002fa-8e8e-11f1-96db-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="73d002fa-8e8e-11f1-96db-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="73e3e4e5-8e8e-11f1-bcb4-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770e52ce-8e8e-11f1-8b2e-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770e52ce-8e8e-11f1-8b2e-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>reach the actuators directly with a veto, without passing through the arbiter or any control loop</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73d010be-8e8e-11f1-a31c-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="74017004-8e8e-11f1-b871-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-SUP-003</val>
</externalId>
<name>
<val>REQ-SUB-SUP-003</val>
</name>
<owningPackage>
<ref refid="73d002fa-8e8e-11f1-96db-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="73d002fa-8e8e-11f1-96db-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="73e58515-8e8e-11f1-98b4-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770e575d-8e8e-11f1-96f6-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770e575d-8e8e-11f1-96f6-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>be the only component permitted to kick the watchdog</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73d013b6-8e8e-11f1-a76b-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="74035401-8e8e-11f1-9d6d-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-SUP-010</val>
</externalId>
<name>
<val>REQ-SUB-SUP-010</val>
</name>
<owningPackage>
<ref refid="73d002fa-8e8e-11f1-96db-01c58a30f183"/>
</owningPackage>
