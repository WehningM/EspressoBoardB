<reflist>
<ref refid="770ec74d-8e8e-11f1-bf38-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>report every violation in one pass rather than stopping at the first</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="74d70e6d-8e8e-11f1-a1aa-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="74e75abd-8e8e-11f1-b9a7-01c58a30f183"/>
</reflist>
</clientDependency>
