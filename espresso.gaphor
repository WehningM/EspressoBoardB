<ref refid="c2c5f4c4-c64c-11f1-ab4f-a029427ff6d8"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>use a finished scale unit (CON-7) whose own converter and filtering reject 50 Hz pump vibration, confirmed on the assembled machine</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="744a0195-8e8e-11f1-8c2c-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="74624644-8e8e-11f1-aae5-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-MAS-003</val>
</externalId>
