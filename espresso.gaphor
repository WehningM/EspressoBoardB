<reflist>
<ref refid="770e5adc-8e8e-11f1-be52-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>maintain a flow estimate that decays toward zero when ticks arrive later than the commanded flow implies</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73d01601-8e8e-11f1-af48-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="74053d4e-8e8e-11f1-bbe3-01c58a30f183"/>
