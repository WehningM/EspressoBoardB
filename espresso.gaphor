<ref refid="770e8ad3-8e8e-11f1-8a2b-01c58a30f183"/>
<ref refid="c2c83904-c64c-11f1-998d-a029427ff6d8"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>operate the scale unit at an I2C address distinct from every other device on the sensor bus</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="744a03d2-8e8e-11f1-bada-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="7463ba1c-8e8e-11f1-9180-01c58a30f183"/>
</reflist>
</clientDependency>
