<reflist>
<ref refid="770f0523-8e8e-11f1-b410-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>expose an integrator preset input for bumpless handover and anti-windup</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="7539dd47-8e8e-11f1-8459-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="754a153f-8e8e-11f1-be71-01c58a30f183"/>
