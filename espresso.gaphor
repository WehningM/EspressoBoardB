<reflist>
<ref refid="770f175f-8e8e-11f1-ba2c-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>drive the heater by integral cycle with the duty distributed across the window</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="754dd999-8e8e-11f1-bd1c-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="75809b22-8e8e-11f1-8333-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-HYD-003</val>
</externalId>
