<ref refid="716cbc70-8e8e-11f1-a6ac-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770d6660-8e8e-11f1-a86b-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770d6660-8e8e-11f1-a86b-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>leave the three-way valve unpowered when the contactor is open, so the valve rests in the tray path</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="714cf3df-8e8e-11f1-946c-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="71a8d004-8e8e-11f1-bda1-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PROT-020</val>
</externalId>
<name>
<val>REQ-SUB-PROT-020</val>
</name>
<owningPackage>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="716e7eff-8e8e-11f1-ba9e-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770d69e1-8e8e-11f1-af88-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770d69e1-8e8e-11f1-af88-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>derive the protection circuit supply on the mains side, independently of the compute node supply</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="714cf65a-8e8e-11f1-827f-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="71aaafb1-8e8e-11f1-b41e-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PROT-021</val>
</externalId>
<name>
<val>REQ-SUB-PROT-021</val>
</name>
<owningPackage>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="7170d232-8e8e-11f1-8ce9-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770d6f18-8e8e-11f1-87f8-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770d6f18-8e8e-11f1-87f8-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>keep the protection circuit functional while the compute node is unpowered, resetting or reflashing</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="714cf890-8e8e-11f1-af66-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="71acbf01-8e8e-11f1-9db7-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PROT-022</val>
</externalId>
<name>
<val>REQ-SUB-PROT-022</val>
</name>
<owningPackage>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="7172a60e-8e8e-11f1-9a71-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770d7668-8e8e-11f1-8177-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770d7668-8e8e-11f1-8177-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>contribute no more than OB-25 to protective earth leakage</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="714cfc56-8e8e-11f1-8e60-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="71ae9237-8e8e-11f1-b62b-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PROT-030</val>
</externalId>
<name>
<val>REQ-SUB-PROT-030</val>
</name>
<owningPackage>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="71749ce8-8e8e-11f1-8cad-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770d7aa0-8e8e-11f1-86ef-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770d7aa0-8e8e-11f1-86ef-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>the thermal fuse shall interrupt the element supply at 318 C independently of every electronic path</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="714cfe9c-8e8e-11f1-8f3b-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="71b0b1c7-8e8e-11f1-93ad-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PROT-031</val>
</externalId>
<name>
<val>REQ-SUB-PROT-031</val>
</name>
<owningPackage>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="717662b4-8e8e-11f1-acc2-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770d7e4e-8e8e-11f1-9c5b-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770d7e4e-8e8e-11f1-9c5b-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>the over-pressure valve shall relieve at 10 bar independently of every electronic path</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="714d00d3-8e8e-11f1-86ed-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="71b2ebd7-8e8e-11f1-b5be-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PROT-032</val>
</externalId>
<name>
<val>REQ-SUB-PROT-032</val>
</name>
<owningPackage>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="7178445f-8e8e-11f1-90f0-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770d81ab-8e8e-11f1-8c91-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770d81ab-8e8e-11f1-8c91-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>the compute node shall be able to read, but never to inhibit, any protection output</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="714d0343-8e8e-11f1-a08c-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="71b32c01-8e8e-11f1-9e48-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PROT-016</val>
</externalId>
<name>
<val>REQ-SUB-PROT-016</val>
</name>
<owningPackage>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="717a180c-8e8e-11f1-a0e1-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770d85d4-8e8e-11f1-984f-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770d85d4-8e8e-11f1-984f-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>the emergency cut shall hold the contactor open until an explicit re-arm action, the latch being mechanical or electronic</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="714d0571-8e8e-11f1-b6e3-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="71b590fb-8e8e-11f1-9bc6-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PROT-017</val>
</externalId>
<name>
<val>REQ-SUB-PROT-017</val>
</name>
<owningPackage>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="717c02ad-8e8e-11f1-b146-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770d8923-8e8e-11f1-a861-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770d8923-8e8e-11f1-a861-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>the emergency cut control shall be distinguishable from the start control by touch alone</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="714d0781-8e8e-11f1-8b77-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="71b93ddc-8e8e-11f1-9438-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PROT-018</val>
</externalId>
<name>
<val>REQ-SUB-PROT-018</val>
</name>
<owningPackage>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="714cd0e9-8e8e-11f1-b75a-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="717dda95-8e8e-11f1-b84d-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770d8c4b-8e8e-11f1-918a-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770d8c4b-8e8e-11f1-918a-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>the heater switching device shall be treated as never fully isolating, so galvanic isolation is provided only by the contactor</val>
</text>
</SysML:Requirement>
<SysML:RequirementDiagram id="714d09aa-8e8e-11f1-98ae-01c58a30f183">
