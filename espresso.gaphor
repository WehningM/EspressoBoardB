<ref refid="770e3bc0-8e8e-11f1-b10f-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>interpret the M104 target as the temperature at the puck, deriving the outlet setpoint through a calibrated offset held in LC-17</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="736872f5-8e8e-11f1-a3ed-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="73a898bd-8e8e-11f1-b6dd-01c58a30f183"/>
