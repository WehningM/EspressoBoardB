<ref refid="770f1ffa-8e8e-11f1-a70d-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>de-energise every actuator on loss of its command source rather than holding the last state</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="754dde3c-8e8e-11f1-8688-01c58a30f183">
