<reflist>
<ref refid="770f1c19-8e8e-11f1-9ce9-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>accept the safety veto directly, without consulting the arbiter or the mode manager</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="754ddbec-8e8e-11f1-9731-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="758417e5-8e8e-11f1-9acd-01c58a30f183"/>
