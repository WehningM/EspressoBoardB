</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>parse a profile into a validated command list before any execution begins</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="72a63d94-8e8e-11f1-a058-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="72e505d0-8e8e-11f1-a132-01c58a30f183"/>
