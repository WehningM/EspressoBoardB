<reflist>
<ref refid="770f0947-8e8e-11f1-b3c5-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>refuse enable below the measurable threshold OB-27 rather than degrade quietly</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="7539dfc7-8e8e-11f1-a3b6-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="754a5170-8e8e-11f1-af7b-01c58a30f183"/>
