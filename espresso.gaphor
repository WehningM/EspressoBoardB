</targetDirectedRelationshipPropertyPath_>
<text>
<val>remove the heater gate drive when the E-Fast burden voltage exceeds OB-22, without any firmware involvement</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="714cda06-8e8e-11f1-b35d-01c58a30f183">
