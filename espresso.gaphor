<reflist>
<ref refid="770e3534-8e8e-11f1-80fe-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>energise the heater only while measured flow exceeds the threshold of REQ-SYS-003</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73686e2c-8e8e-11f1-bea9-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="738fc9b5-8e8e-11f1-9243-01c58a30f183"/>
</reflist>
