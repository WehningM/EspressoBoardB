<UML:Property id="c271c621-c64c-11f1-9066-a029427ff6d8">
<name>
<val>ESP32-S3 (PREMISE: S3 over classic)</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c271d171-c64c-11f1-a814-a029427ff6d8">
<name>
<val>ESP32-S3-WROOM-1-N8R2: 8 MB flash, 2 MB quad PSRAM</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c271dbc0-c64c-11f1-916e-a029427ff6d8">
<name>
<val>quad, not octal PSRAM: GPIO35/36 carry E-Fast trip and zero-cross</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c271e626-c64c-11f1-8baf-a029427ff6d8">
<name>
<val>rated -40 to 85 C; -H4 variant if the air at the board exceeds 75 C (REQ-SYS-107)</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c271f032-c64c-11f1-9a30-a029427ff6d8">
<name>
<val>dual-core MCU</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c271fa14-c64c-11f1-bae7-a029427ff6d8">
<name>
<val>core 0: network, web, logging, UI</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c27203d8-c64c-11f1-bd92-a029427ff6d8">
<name>
<val>core 1: control loops, mode manager, safety supervisor</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c2720da6-c64c-11f1-85e9-a029427ff6d8">
<name>
<val>hardware timer ISR: zero-cross capture and SCR firing</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c2721771-c64c-11f1-bf70-a029427ff6d8">
<name>
<val>windowed watchdog, kicked only from core 1</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c272213e-c64c-11f1-b7a9-a029427ff6d8">
<name>
<val>partitioning by convention, not enforced without an MPU</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c2722b15-c64c-11f1-b56e-a029427ff6d8">
<name>
<val>USB-Serial-JTAG on USB-C: only programming, console and debug port (REQ-SYS-065)</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c272350c-c64c-11f1-be2e-a029427ff6d8">
<name>
<val>BOOT button forces the ROM bootloader for recovery (REQ-SUB-UPD-005)</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c2723eff-c64c-11f1-bf4b-a029427ff6d8">
<name>
<val>calibration in internal non-volatile memory (REQ-SYS-089)</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c27248a9-c64c-11f1-83b8-a029427ff6d8">
<name>
<val>UART1 to HN-6; UART0 kept for the boot log</val>
</name>
<structuredClassifier>
<ref refid="71151613-8e8e-11f1-8065-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c272c911-c64c-11f1-9d3f-a029427ff6d8">
<name>
<val>SELV side, on Board A</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c272d43d-c64c-11f1-91f9-a029427ff6d8">
<name>
<val>J-type thermocouples, heater outlet and brew head</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c272deae-c64c-11f1-903a-a029427ff6d8">
<name>
<val>MCP9600 per channel on Board A, I2C 0x60 and 0x67, integrated cold junction</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c272e8a5-c64c-11f1-88ac-a029427ff6d8">
<name>
<val>thermocouple terminal beside its MCP9600 on an isothermal island (REQ-SYS-092)</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c272f280-c64c-11f1-8585-a029427ff6d8">
<name>
<val>ungrounded junction probes to avoid a PE ground loop</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c272fc51-c64c-11f1-a2b9-a029427ff6d8">
<name>
<val>FTH II NTC and tank NTC on HN-1 ADC1 through 0.1 % dividers (REQ-SUB-SEN-013)</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c273062b-c64c-11f1-a2b7-a029427ff6d8">
<name>
<val>divider supply measured on ADC1, NTC readings ratiometric</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c2730fed-c64c-11f1-b015-a029427ff6d8">
<name>
<val>ADC2 unused: unavailable while Wi-Fi is active</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c27319e9-c64c-11f1-8fb8-a029427ff6d8">
<name>
<val>one I2C bus, one pull-up pair: thermocouple converters, pressure, scale (REQ-SUB-SEN-012)</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c27323b5-c64c-11f1-ad47-a029427ff6d8">
<name>
<val>pressure over I2C</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c2732d6d-c64c-11f1-bf1f-a029427ff6d8">
<name>
<val>flow ticks through RC filter and Schmitt trigger to a GPIO interrupt (REQ-SUB-SEN-011)</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c273374f-c64c-11f1-ac3f-a029427ff6d8">
<name>
<val>tank level switch, debounced in hardware, to GPIO (REQ-SUB-SEN-014)</val>
</name>
<structuredClassifier>
<ref refid="711545e4-8e8e-11f1-831a-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c2737acc-c64c-11f1-a94b-a029427ff6d8">
<name>
<val>SELV side on Board A, mains side on Board B</val>
</name>
<structuredClassifier>
<ref refid="711592c6-8e8e-11f1-aac1-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c2738527-c64c-11f1-a438-a029427ff6d8">
<name>
<val>optocouplers for SSR, SCR gate and contactor hold on Board B</val>
</name>
<structuredClassifier>
<ref refid="711592c6-8e8e-11f1-aac1-01c58a30f183"/>
</structuredClassifier>
</UML:Property>
<UML:Property id="c27390cf-c64c-11f1-a3cc-a029427ff6d8">
<name>
<val>valve and spare: relay with floating contact on Board A (REQ-SUB-HYD-011)</val>
