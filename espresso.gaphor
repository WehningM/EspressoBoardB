<reflist>
<ref refid="770e27bb-8e8e-11f1-afe6-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>trim the outlet setpoint with a slow loop closed on the brew head sensor, this being the outer loop of a cascade</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="7368671d-8e8e-11f1-abd1-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="7387a4c6-8e8e-11f1-9d13-01c58a30f183"/>
</reflist>
