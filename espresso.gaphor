<ref refid="c2962861-c64c-11f1-8d40-a029427ff6d8"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>acquire temperature through a converter that stays available while the network is active</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="75989cc5-8e8e-11f1-85a9-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="75b70dc6-8e8e-11f1-acc1-01c58a30f183"/>
