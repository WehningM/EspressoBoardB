<reflist>
<ref refid="770e387c-8e8e-11f1-ab97-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>distribute integral cycle duty across the modulation window rather than bursting it contiguously, per REQ-SYS-096</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73687085-8e8e-11f1-8ecf-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="73a54703-8e8e-11f1-a770-01c58a30f183"/>
</reflist>
</clientDependency>
