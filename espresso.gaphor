</targetDirectedRelationshipPropertyPath_>
<text>
<val>reject a profile with no termination condition, so no profile can run unbounded</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="74d715ae-8e8e-11f1-9c11-01c58a30f183">
