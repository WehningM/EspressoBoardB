<reflist>
<ref refid="770fef64-8e8e-11f1-8dde-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>predict time to readiness from measured thermal state rather than from elapsed time</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="769e340e-8e8e-11f1-9f46-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="76c83051-8e8e-11f1-b2bb-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
