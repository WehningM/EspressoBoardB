<reflist>
<ref refid="770e248f-8e8e-11f1-8333-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>trim the feedforward with a loop closed on the heater outlet sensor</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="736864ae-8e8e-11f1-86aa-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="73860e2d-8e8e-11f1-ae60-01c58a30f183"/>
</reflist>
</clientDependency>
