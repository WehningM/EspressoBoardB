<reflist>
<ref refid="770ec3f9-8e8e-11f1-8c1f-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>validate against the machine's own envelope, since limits derive from this machine's calibration</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="74d70b80-8e8e-11f1-96bc-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="74e59960-8e8e-11f1-a221-01c58a30f183"/>
