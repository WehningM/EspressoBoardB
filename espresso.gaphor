<ref refid="770ff3c5-8e8e-11f1-9e64-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>run the wake self-test before permitting any actuation</val>
</text>
</SysML:Requirement>
