<ref refid="770e213f-8e8e-11f1-af3a-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>compute heater power feedforward as measured flow times specific heat times the rise from tank temperature to target</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73686175-8e8e-11f1-961a-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="7382ef82-8e8e-11f1-885d-01c58a30f183"/>
