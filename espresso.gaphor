</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>interpolate the commanded ramp so the setpoint changes once per control cycle</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="74f2ffc7-8e8e-11f1-8c99-01c58a30f183">
