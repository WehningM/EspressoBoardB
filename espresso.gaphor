</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>the grate assembly shall transmit its load to the cell through a lever, with no second force path to the tray or the frame</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="744a0a82-8e8e-11f1-a14a-01c58a30f183">
