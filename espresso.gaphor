</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-MOD-001</val>
</externalId>
<name>
<val>REQ-SUB-MOD-001</val>
</name>
<owningPackage>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="769e3c5b-8e8e-11f1-ba05-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770fcd61-8e8e-11f1-9336-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770fcd61-8e8e-11f1-9336-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>own the mode automaton of D-12 and be the only writer of machine state</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="769e2273-8e8e-11f1-b100-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="76b45e63-8e8e-11f1-b55e-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-MOD-002</val>
</externalId>
<name>
<val>REQ-SUB-MOD-002</val>
</name>
<owningPackage>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="769f9dc1-8e8e-11f1-9063-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770fd1df-8e8e-11f1-b995-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770fd1df-8e8e-11f1-b995-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>grant heater permission per mode, refusing it in Sleep, Self-test, Post-shot, Backflush and Fault</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="769e24f3-8e8e-11f1-88c9-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="76b76b9e-8e8e-11f1-b3a2-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-MOD-003</val>
</externalId>
<name>
<val>REQ-SUB-MOD-003</val>
</name>
<owningPackage>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="76a18c80-8e8e-11f1-8e1e-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770fd6b4-8e8e-11f1-b577-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770fd6b4-8e8e-11f1-b577-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>predict time to readiness from measured thermal state and reject a shot beyond 20 s</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="769e2768-8e8e-11f1-a49e-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="76ba92ba-8e8e-11f1-a7ae-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-MOD-004</val>
</externalId>
<name>
<val>REQ-SUB-MOD-004</val>
</name>
<owningPackage>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="76a35841-8e8e-11f1-93f8-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770fdb12-8e8e-11f1-bd94-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770fdb12-8e8e-11f1-bd94-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>start a queued shot automatically on reaching Ready, and expire it after OB-8</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="769e29b6-8e8e-11f1-a4bb-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="76bc3f3e-8e8e-11f1-bc72-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-MOD-005</val>
</externalId>
<name>
<val>REQ-SUB-MOD-005</val>
</name>
<owningPackage>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="76a540ec-8e8e-11f1-a8e9-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770fe04e-8e8e-11f1-9aed-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770fe04e-8e8e-11f1-9aed-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>begin conditioning automatically only on wake, every later attempt needing approval</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="769e2be8-8e8e-11f1-988d-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="76be2140-8e8e-11f1-90f6-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-MOD-006</val>
</externalId>
<name>
<val>REQ-SUB-MOD-006</val>
</name>
<owningPackage>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="76a6fd17-8e8e-11f1-bd86-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770fe4c5-8e8e-11f1-b8c7-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770fe4c5-8e8e-11f1-b8c7-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>leave Fault only on explicit acknowledgement, and then to Sleep</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="769e2e07-8e8e-11f1-97db-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="76c163ae-8e8e-11f1-bb0e-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-MOD-007</val>
</externalId>
<name>
<val>REQ-SUB-MOD-007</val>
</name>
<owningPackage>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="769e199c-8e8e-11f1-8b5f-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="76a8e340-8e8e-11f1-8bfd-01c58a30f183"/>
</reflist>
