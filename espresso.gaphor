<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770f1426-8e8e-11f1-8fb3-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>fire the pump device once per mains cycle from the hardware timer, never from a task</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="754dd70e-8e8e-11f1-9637-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="757cb036-8e8e-11f1-b9ce-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-HYD-002</val>
</externalId>
