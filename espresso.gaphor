<reflist>
<ref refid="770ecb43-8e8e-11f1-a680-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>reject a profile that commands pressure above the OPV margin of REQ-SYS-023</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="74d710df-8e8e-11f1-a483-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="74eaa0d8-8e8e-11f1-b9ec-01c58a30f183"/>
