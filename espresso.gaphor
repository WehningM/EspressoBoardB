</targetDirectedRelationshipPropertyPath_>
<text>
<val>deliver tank temperature at a rate sufficient for the thermal feedforward</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="7598a129-8e8e-11f1-b9a3-01c58a30f183">
