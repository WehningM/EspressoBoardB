</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>connect the scale unit by the I2C bus and its supply only, with no converter clock or timing handled by the compute node</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="744a07c0-8e8e-11f1-a37c-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="74658223-8e8e-11f1-b322-01c58a30f183"/>
