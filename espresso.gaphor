<SysML:Requirement id="752262cb-8e8e-11f1-b6d5-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="752d23f7-8e8e-11f1-8bbf-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PRS-001</val>
</externalId>
<name>
<val>REQ-SUB-PRS-001</val>
</name>
<owningPackage>
<ref refid="75225c2f-8e8e-11f1-aad1-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="75225c2f-8e8e-11f1-aad1-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="75227960-8e8e-11f1-973e-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770eeb26-8e8e-11f1-8cec-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770eeb26-8e8e-11f1-8cec-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>close the loop on the pressure reading taken ahead of the brew head</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="75226895-8e8e-11f1-93cc-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="7530c31c-8e8e-11f1-8523-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PRS-002</val>
</externalId>
<name>
<val>REQ-SUB-PRS-002</val>
</name>
<owningPackage>
<ref refid="75225c2f-8e8e-11f1-aad1-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="75225c2f-8e8e-11f1-aad1-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="7523d194-8e8e-11f1-931c-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770eefa3-8e8e-11f1-87d1-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770eefa3-8e8e-11f1-87d1-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>expose an integrator preset input for bumpless handover and anti-windup</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="75226c8f-8e8e-11f1-823f-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="753452d4-8e8e-11f1-9855-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PRS-003</val>
</externalId>
<name>
<val>REQ-SUB-PRS-003</val>
</name>
<owningPackage>
<ref refid="75225c2f-8e8e-11f1-aad1-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="75225c2f-8e8e-11f1-aad1-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="7525b56f-8e8e-11f1-9aba-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770ef40f-8e8e-11f1-9586-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770ef40f-8e8e-11f1-9586-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>bound its output to the pump map range rather than to an abstract percentage</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="75227025-8e8e-11f1-8fc1-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="7536158d-8e8e-11f1-b9cd-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PRS-004</val>
</externalId>
<name>
<val>REQ-SUB-PRS-004</val>
</name>
<owningPackage>
<ref refid="75225c2f-8e8e-11f1-aad1-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="75225c2f-8e8e-11f1-aad1-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="752770b2-8e8e-11f1-8d52-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770ef7a4-8e8e-11f1-8c5e-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770ef7a4-8e8e-11f1-8c5e-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>use the pump map as feedforward so the integrator corrects rather than establishes the operating point</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="75227294-8e8e-11f1-aa68-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="75380225-8e8e-11f1-85e5-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-PRS-005</val>
</externalId>
<name>
<val>REQ-SUB-PRS-005</val>
</name>
<owningPackage>
<ref refid="75225c2f-8e8e-11f1-aad1-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="75225c2f-8e8e-11f1-aad1-01c58a30f183"/>
</package>
<presentation>
<reflist>
<ref refid="752938a4-8e8e-11f1-a21e-01c58a30f183"/>
</reflist>
</presentation>
<supplierDependency>
<reflist>
<ref refid="770efd94-8e8e-11f1-b88d-01c58a30f183"/>
</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770efd94-8e8e-11f1-b88d-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>hold its gains in calibration, not in source, so tuning survives a firmware update</val>
</text>
</SysML:Requirement>
