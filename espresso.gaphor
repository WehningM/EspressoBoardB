</reflist>
</supplierDependency>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="770e73c0-8e8e-11f1-8067-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>record fault cause and machine state at the moment of the fault into the shot log</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="73d02560-8e8e-11f1-a368-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="7411d8b5-8e8e-11f1-9d42-01c58a30f183"/>
</reflist>
</clientDependency>
<externalId>
<val>REQ-SUB-SUP-030</val>
</externalId>
<name>
<val>REQ-SUB-SUP-030</val>
</name>
<owningPackage>
<ref refid="73d002fa-8e8e-11f1-96db-01c58a30f183"/>
</owningPackage>
<package>
<ref refid="73d002fa-8e8e-11f1-96db-01c58a30f183"/>
</package>
