<reflist>
<ref refid="770f0cd6-8e8e-11f1-9031-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>use the pump map as feedforward, the loop correcting for puck resistance only</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="7539e217-8e8e-11f1-a815-01c58a30f183">
