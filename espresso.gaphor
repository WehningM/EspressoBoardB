<reflist>
<ref refid="770e2aef-8e8e-11f1-9c55-01c58a30f183"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>compensate the transport delay between heating surface and outlet sensor, that delay being channel volume divided by flow</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="736869bc-8e8e-11f1-861d-01c58a30f183">
<clientDependency>
<reflist>
<ref refid="73895a29-8e8e-11f1-845e-01c58a30f183"/>
</reflist>
</clientDependency>
